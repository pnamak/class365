# Class 365 — Sea Notes SaaS starter kit environment
# Copy to .env before running locally.
# Architecture based on: https://github.com/digitalocean/sea-notes-saas-starter-kit

# ====================
# DATABASE
# ====================
# Local default uses SQLite (no Docker required).
DATABASE_PROVIDER=SQLite
DATABASE_URL="file:./dev.db"

# For DigitalOcean / Postgres (Sea Notes default), use:
# DATABASE_PROVIDER=Postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/class365_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=class365_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ====================
# AUTHENTICATION (NextAuth — Sea Notes pattern)
# ====================
AUTH_SECRET=class365-dev-secret-change-me
BASE_URL=http://localhost:3000

# ====================
# FILE STORAGE (DigitalOcean Spaces)
# ====================
STORAGE_PROVIDER=Spaces
SPACES_KEY_ID=
SPACES_SECRET_KEY=
SPACES_REGION=nyc3
SPACES_BUCKET_NAME=

# ====================
# EMAIL (Resend)
# ====================
EMAIL_PROVIDER=Resend
RESEND_API_KEY=
RESEND_EMAIL_SENDER=
ENABLE_EMAIL_INTEGRATION=false

# ====================
# BILLING (Stripe — school SaaS subscriptions)
# ====================
BILLING_PROVIDER=Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_GIFT_PRICE_ID=
STRIPE_PORTAL_CONFIG_ID=

# ====================
# AI (DigitalOcean GradientAI)
# ====================
INVOICE_PROVIDER=DigitalOcean GradientAI
DO_INFERENCE_API_KEY=
NEXT_PUBLIC_DIGITALOCEAN_GRADIENTAI_ENABLED=false
